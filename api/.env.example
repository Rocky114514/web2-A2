# Copy this file to ".env" and update the values for your local MySQL setup.
# The file named ".env" is git-ignored so your real password never leaves your PC.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=charityevents_db

# Optional: change the port the API listens on (default is 3000).
PORT=3000
